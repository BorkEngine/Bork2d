<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
    </PropertyGroup>

    <ItemGroup>
        <!-- A minimal Project.Common-like fixture: registered game data types only. It references
             Bork2d.Api (the game contract) and nothing from the bake tooling, so the bake and AOT
             proofs exercise the same boundary a real game has (Q-16). WP5 adds the fixture's
             Assets/ tree and targets; WP6 adds the AOT baked-pack proof. -->
        <ProjectReference Include="..\Bork2d.Api\Bork2d.Api.csproj" />
    </ItemGroup>

</Project>
