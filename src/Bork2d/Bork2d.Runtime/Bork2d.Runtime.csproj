<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <!-- The SDL adapter and its native-library context use unmanaged pointers. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bork2d.Engine\Bork2d.Engine.csproj" />
        <ProjectReference Include="..\Bork2d.Render\Bork2d.Render.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0-rc.1.26425.128" />
        <PackageReference Include="Silk.NET.SDL" Version="2.23.0" />
        <PackageReference Include="ZLogger" Version="2.5.10" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bork2d.Tests" />
    </ItemGroup>

    <!-- Build-time built-in shader pack -> embedded C#. The generator is JIT and build-only; the
         generated pack is compiled into this assembly, so the runtime needs no pack file, tooling,
         shader compiler, or filesystem I/O at startup. -->
    <Import Project="..\..\..\build\Bork2d.BuiltInAssets.targets" />

</Project>
