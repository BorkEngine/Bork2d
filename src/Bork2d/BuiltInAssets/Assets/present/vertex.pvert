#version 460

// Bork2d built-in present vertex shader.
//
// A single triangle covers the whole target: there is no vertex buffer and no push constant. The
// normalized target coordinate is written as an interpolant so the fragment stage samples the
// linear scene image exactly once per target pixel.
//
// Triangle-strip order is irrelevant here; the three vertices are (-1,-1), (3,-1), (-1,3) in clip
// space, and the visible [-1,1] square interpolates the coordinate as (0,0)..(1,1) with a top-left
// origin, matching the scene image's Vulkan texel origin.

layout(location = 0) out vec2 vTargetUv;

void main()
{
    vec2 corner = vec2(float((gl_VertexIndex << 1) & 2), float(gl_VertexIndex & 2));
    vTargetUv = corner;
    gl_Position = vec4((corner * 2.0) - 1.0, 0.0, 1.0);
}
