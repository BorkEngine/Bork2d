<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <!-- Tooling is a JIT library. It references the engine contract and the pack writer.
             Q-20 (no engine implementation dependency) is test-enforced by the metadata guard. -->
        <ProjectReference Include="..\Bork2d.Engine\Bork2d.Engine.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Tomlyn parses source/sidecar TOML, StbImageSharp decodes texture sources (the WP1
             texture pipeline remains the only texture producer), System.IO.Hashing supplies the
             deterministic hash primitive WP5 reuses, and PolyType supplies the compiled shape
             metadata the explicit registrations bind through. There is no MetadataLoadContext: the
             generated host and its metadata type resolution were removed in WP1 (D-038). -->
        <PackageReference Include="PolyType" Version="1.4.1" />
        <PackageReference Include="StbImageSharp" Version="2.30.16" />
        <PackageReference Include="System.IO.Hashing" Version="11.0.0-rc.1.26425.128" />
        <PackageReference Include="Tomlyn" Version="2.10.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- Bake tooling is internal by default; the public builder, the editor, and tests see it.
             There is no host or CLI grant: both were removed in WP1. -->
        <InternalsVisibleTo Include="Bork2d.Editor" />
        <InternalsVisibleTo Include="Bork2d.Tests" />
    </ItemGroup>

</Project>
