<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!--
            Narrow AOT-publisher suppression. Silk.NET.Core.Loader.DefaultPathResolver (reached via
            Sdl.GetApi()) probes Assembly.Location/CodeBase/DependencyContext for native-library
            candidates; ILC reports those single-file probes as IL3000/IL3002. Bork2d's SDL2 native
            ships from Silk.NET.SDL and is resolved by the runtime's normal native-asset lookup, so
            the flagged fallback paths are not used. Only these two trim codes are suppressed, and
            only in this AOT publisher (M2 WP5's windowed demo publishes from this project too).
            Remove the suppression when Silk.NET stops probing those APIs.
        -->
        <NoWarn>$(NoWarn);IL3000;IL3002</NoWarn>
    </PropertyGroup>

    <!--
        M4 bake integration (D-M4-08, D-M4-09, Q-10/Q-11/Q-22). This app owns the runtime pack: the
        imported targets generate and build the bake host from the committed Bork2d.BakeFixture
        project and its prepared Assets/ copy, bake $(TargetDir)assets.pck, copy it to PublishDir,
        and remove the generated artifacts on Clean. The tool is built and executed out of process,
        so nothing from Bork2d.Bake/Tomlyn/StbImageSharp enters this app's AOT publish graph. The
        default headless smoke loads $(TargetDir)assets.pck from AppContext.BaseDirectory; the
        fixture reference below is the only bake-related assembly in the publish.
    -->
    <PropertyGroup>
        <Bork2dBakeUseFixtureAssets>true</Bork2dBakeUseFixtureAssets>
        <Bork2dBakeCommonAssemblyName>Bork2d.BakeFixture</Bork2dBakeCommonAssemblyName>
        <Bork2dProjectDescriptor>$(MSBuildProjectDirectory)\obj\bork2d\fixture\bork2d.project.toml</Bork2dProjectDescriptor>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bork2d.Api\Bork2d.Api.csproj" />
        <ProjectReference Include="..\Bork2d.BakeFixture\Bork2d.BakeFixture.csproj" />
        <ProjectReference Include="..\Bork2d.Common\Bork2d.Common.csproj" />
        <ProjectReference Include="..\Bork2d.Runtime\Bork2d.Runtime.csproj" />
    </ItemGroup>

    <!-- Tooling only: imported, never referenced. -->
    <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\Bork2d.Bake.targets" />

</Project>
