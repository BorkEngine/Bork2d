<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!--
            Narrow AOT-publisher suppression. Silk.NET.Core.Loader.DefaultPathResolver (reached via
            Sdl.GetApi()) probes Assembly.Location/CodeBase/DependencyContext for native-library
            candidates; ILC reports those single-file probes as IL3000/IL3002. Bork2d's SDL2 native
            ships from Silk.NET.SDL and is resolved by the runtime's normal native-asset lookup, so
            the flagged fallback paths are not used. Only these two trim codes are suppressed, and
            only in this AOT publisher (M2 WP5's windowed demo publishes from this project too).
            Remove the suppression when Silk.NET stops probing those APIs.
        -->
        <NoWarn>$(NoWarn);IL3000;IL3002</NoWarn>
    </PropertyGroup>

    <!--
        The fixture assets executable owns the fixture source trees, the explicit data-type
        registrations, and the bake configuration. It is a build-time dependency only: the imported
        copy target builds it out of process, bakes assets.pck/dlc1.pck next to its own executable,
        and asks it to copy both packs to this app's output and publish directories. It is
        deliberately not a ProjectReference: the SDK copies an executable reference's apphost,
        deps.json, and runtimeconfig.json into the referencing app (transitive content) and rejects a
        self-contained app referencing a JIT executable. Neither the builder nor the assets
        executable enters this app's compile or AOT publish graph. The default headless smoke mounts
        AppContext.BaseDirectory/assets.pck and overlays dlc1.pck.
    -->
    <PropertyGroup>
        <Bork2dAssetsProjectDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Bork2d.BakeFixture.Assets'))</Bork2dAssetsProjectDirectory>
        <Bork2dAssetsProjectFile>$(Bork2dAssetsProjectDirectory)\Bork2d.BakeFixture.Assets.csproj</Bork2dAssetsProjectFile>
        <Bork2dAssetsExecutable>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Bork2d.BakeFixture.Assets\bin\$(Configuration)\net11.0\Bork2d.BakeFixture.Assets.dll'))</Bork2dAssetsExecutable>
        <Bork2dAssetsTargetFramework>net11.0</Bork2dAssetsTargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bork2d.Api\Bork2d.Api.csproj" />
        <ProjectReference Include="..\Bork2d.BakeFixture\Bork2d.BakeFixture.csproj" />
        <ProjectReference Include="..\Bork2d.Common\Bork2d.Common.csproj" />
        <ProjectReference Include="..\Bork2d.Runtime\Bork2d.Runtime.csproj" />
    </ItemGroup>

    <!-- Tooling only: imported, never referenced. -->
    <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\Bork2d.Assets.Copy.targets" />

</Project>
