<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
    </PropertyGroup>

    <ItemGroup>
        <!-- The IShapeable<T> constraint on IAssets.LoadAsset<T> is the only PolyType contract
             surface in Bork2d.Api. No Nerdbank.MessagePack, Zstd, or file I/O belongs here. -->
        <PackageReference Include="PolyType" Version="1.4.1" />
    </ItemGroup>

</Project>
