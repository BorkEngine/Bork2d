<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
    </PropertyGroup>

    <ItemGroup>
        <!-- PolyType supplies the IShapeable<T> contract, the generated shapes for the public
             asset types, and the path marshalers for AssetRef<T>/DataRef. No
             Nerdbank.MessagePack, Zstd, or file I/O belongs here. -->
        <PackageReference Include="PolyType" Version="1.4.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- The pack builder uses the internal reference marker to validate asset links without
             adding public API surface or reflection. -->
        <InternalsVisibleTo Include="Bork2d.Assets" />
    </ItemGroup>

</Project>
