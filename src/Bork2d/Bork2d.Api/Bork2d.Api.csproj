<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!--
            The net11.0 shared framework already ships this assembly at the same version, so NuGet
            reports NU1510 (redundant reference). Keep the explicit pin: it documents the only
            allowed external contract dependency and fails loudly if the framework ever stops
            providing it. NU1510 is suppressed for this package only.
        -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-rc.1.26425.128" NoWarn="NU1510" />
    </ItemGroup>

</Project>
