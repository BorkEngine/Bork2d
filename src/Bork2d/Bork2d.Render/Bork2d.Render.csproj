<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <!-- The Vulkan binding surface and opaque native handles use unmanaged pointers. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bork2d.Engine\Bork2d.Engine.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bork2d.Runtime" />
        <InternalsVisibleTo Include="Bork2d.Tests" />
    </ItemGroup>

    <!-- Build-time GLSL -> SPIR-V -> generated C#. The tool is JIT and build-only; it never enters
         this project's references, output, or publish graph, and no Vulkan SDK is required. -->
    <Import Project="..\..\..\build\Bork2d.ShaderCompiler.targets" />

</Project>
