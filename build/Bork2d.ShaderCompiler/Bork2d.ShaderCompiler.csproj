<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Bork2d.ShaderCompiler</RootNamespace>
        <AssemblyName>Bork2d.ShaderCompiler</AssemblyName>
        <!-- Build-time JIT tooling only: never AOT-compatible and never referenced by a runtime project. -->
        <IsAotCompatible>false</IsAotCompatible>
        <PublishAot>false</PublishAot>
        <IsPackable>false</IsPackable>
        <!-- Shaderc returns raw pointers; the tool is build-time only. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET.Shaderc" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Shaderc.Native" Version="2.23.0" />
    </ItemGroup>

</Project>
