<Solution>
  <!--
    Keep the engine projects in this solution so a Release solution build configures their project
    references as Release too; otherwise they fall back to Debug and a Release app carries a Debug
    runtime assembly and prints Debug-level logs.
  -->
  <Project Path="../../src/Bork2d/Bork2d.Engine/Bork2d.Engine.csproj" />
  <Project Path="../../src/Bork2d/Bork2d.Render/Bork2d.Render.csproj" />
  <Project Path="../../src/Bork2d/Bork2d.Runtime/Bork2d.Runtime.csproj" />
  <Project Path="Pong.Assets/Pong.Assets.csproj" />
  <Project Path="Pong.Common/Pong.Common.csproj" />
  <!--
    The desktop copy target bakes/copies the assets executable out of process. It is not a project
    reference (the AOT app must not reference the JIT assets executable), so the solution records
    the build order explicitly; otherwise a parallel solution build can start the copy before the
    assets bake has written assets.pck.
  -->
  <Project Path="Pong.Desktop/Pong.Desktop.csproj">
    <BuildDependency Project="Pong.Assets/Pong.Assets.csproj" />
  </Project>
</Solution>
